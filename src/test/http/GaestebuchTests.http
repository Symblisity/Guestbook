### TC-05: Alle Eintraege auslesen (absteigend nach ID)
GET http://localhost:8080/guestbook/entries
Accept: application/json

> {%
    client.test("TC-05 GET All: Reihenfolge und Inhalt", function() {
        client.assert(response.status === 200, "Status sollte 200 sein.");
        client.assert(response.body.length === 2, "Liste sollte genau 2 Elemente enthalten.");
        client.assert(response.body[0].id === 2, "Erstes Element sollte ID 2 haben.");
        client.assert(response.body[0].title === "Gern wieder", "Titel stimmt nicht.");
        client.assert(response.body[0].comment === "Sehr freundliches Personal.", "Kommentar stimmt nicht.");
        client.assert(response.body[0].commenter === "Tim Wagner", "Kommentator stimmt nicht.");
        client.assert(response.body[1].id === 1, "Zweites Element sollte ID 1 haben.");
        client.assert(response.body[1].title === "Wunderbarer Abend", "Titel stimmt nicht.");
        client.assert(response.body[1].comment === "Das Essen war hervorragend.", "Kommentar stimmt nicht.");
        client.assert(response.body[1].commenter === "Lena Hoffmann", "Kommentator stimmt nicht.");
    });
%}

### TC-06: Eintrag aendern (ID steht im Body)
PUT http://localhost:8080/guestbook/entries
Content-Type: application/json

{
  "id": 2,
  "title": "Gern wieder (Nachtrag)",
  "comment": "Wir kommen im Frühjahr zurück.",
  "commenter": "Tim Wagner"
}

> {%
    client.test("TC-06 PUT: Eintrag 2 geaendert", function() {
        client.assert(response.status === 200, "Status sollte 200 sein.");
        client.assert(response.body.id === 2, "ID stimmt nicht.");
        client.assert(response.body.title === "Gern wieder (Nachtrag)", "Titel stimmt nicht.");
        client.assert(response.body.comment === "Wir kommen im Frühjahr zurück.", "Kommentar stimmt nicht.");
        client.assert(response.body.commenter === "Tim Wagner", "Kommentator stimmt nicht.");
    });
%}

