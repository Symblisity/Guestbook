### TC-12: Anlegen mit mitgesendeter ID (wird ignoriert)
POST http://localhost:8080/guestbook/entries
Content-Type: application/json

{
  "id": 77,
  "title": "Mit ID",
  "comment": "Die ID sollte ignoriert werden.",
  "commenter": "Eva Klein"
}

> {%
    client.test("TC-12 POST: mitgesendete ID wird ignoriert", function() {
        client.assert(response.status === 201, "Status sollte 201 sein.");
        client.assert(response.body.id === 3, "ID sollte 3 sein, nicht 77.");
        client.assert(response.body.title === "Mit ID", "Titel stimmt nicht.");
        client.assert(response.body.comment === "Die ID sollte ignoriert werden.", "Kommentar stimmt nicht.");
        client.assert(response.body.commenter === "Eva Klein", "Kommentator stimmt nicht.");
    });
%}

