### TC-15: Alle Eintraege nach dem Loeschen auslesen
GET http://localhost:8080/guestbook/entries
Accept: application/json

> {%
    client.test("TC-15 GET All: Liste nach dem Loeschen", function() {
        client.assert(response.status === 200, "Status sollte 200 sein.");
        client.assert(response.body.length === 2, "Liste sollte genau 2 Elemente enthalten.");
        client.assert(response.body[0].id === 3, "Erstes Element sollte ID 3 haben.");
        client.assert(response.body[0].title === "Mit ID", "Titel stimmt nicht.");
        client.assert(response.body[1].id === 2, "Zweites Element sollte ID 2 haben.");
        client.assert(response.body[1].title === "Gern wieder (Nachtrag)", "Titel stimmt nicht.");
    });
%}

### TC-16: Bereits geloeschten Eintrag erneut loeschen
DELETE http://localhost:8080/guestbook/entries/1
Accept: application/json

> {%
    client.test("TC-16 DELETE: erneutes Loeschen", function() {
        client.assert(response.status === 204, "Status sollte 204 sein.");
    });
%}

