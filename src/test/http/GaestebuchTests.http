### TC-01: Leeres Gaestebuch auslesen
GET http://localhost:8080/guestbook/entries
Accept: application/json

> {%
    client.test("TC-01 GET All: Gaestebuch ist leer", function() {
        client.assert(response.status === 200, "Status sollte 200 sein.");
        client.assert(response.body.length === 0, "Liste sollte leer sein.");
    });
%}

### TC-02: Ersten Eintrag anlegen
POST http://localhost:8080/guestbook/entries
Content-Type: application/json

{
  "title": "Wunderbarer Abend",
  "comment": "Das Essen war hervorragend.",
  "commenter": "Lena Hoffmann"
}

> {%
    client.test("TC-02 POST: erster Eintrag angelegt", function() {
        client.assert(response.status === 201, "Status sollte 201 sein.");
        client.assert(response.body.id === 1, "ID stimmt nicht.");
        client.assert(response.body.title === "Wunderbarer Abend", "Titel stimmt nicht.");
        client.assert(response.body.comment === "Das Essen war hervorragend.", "Kommentar stimmt nicht.");
        client.assert(response.body.commenter === "Lena Hoffmann", "Kommentator stimmt nicht.");
    });
%}

### TC-03: Zweiten Eintrag anlegen
POST http://localhost:8080/guestbook/entries
Content-Type: application/json

{
  "title": "Gern wieder",
  "comment": "Sehr freundliches Personal.",
  "commenter": "Tim Wagner"
}

> {%
    client.test("TC-03 POST: zweiter Eintrag angelegt", function() {
        client.assert(response.status === 201, "Status sollte 201 sein.");
        client.assert(response.body.id === 2, "ID stimmt nicht.");
        client.assert(response.body.title === "Gern wieder", "Titel stimmt nicht.");
        client.assert(response.body.comment === "Sehr freundliches Personal.", "Kommentar stimmt nicht.");
        client.assert(response.body.commenter === "Tim Wagner", "Kommentator stimmt nicht.");
    });
%}

